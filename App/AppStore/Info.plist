<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAudioCaptureUsageDescription</key>
	<string>ILoveNotch listens to what's playing so the media waveform moves with the music. Audio is analyzed on this Mac as it plays and is never recorded.</string>
	<!-- This edition makes no network requests, so it has no encryption to declare, and App Store
	     Connect stops asking about export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
